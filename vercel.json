{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd client && npm install",
  "buildCommand": "cd client && npm run build",
  "outputDirectory": "client/build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://chalchitra-backend.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://chalchitra-backend.onrender.com/uploads/:path*"
    },
    {
      "source": "/hero/:path*",
      "destination": "https://chalchitra-backend.onrender.com/hero/:path*"
    },
    {
      "source": "/about/:path*",
      "destination": "https://chalchitra-backend.onrender.com/about/:path*"
    },
    {
      "source": "/gallery/:path*",
      "destination": "https://chalchitra-backend.onrender.com/gallery/:path*"
    },
    {
      "source": "/team/:path*",
      "destination": "https://chalchitra-backend.onrender.com/team/:path*"
    },
    {
      "source": "/logos/:path*",
      "destination": "https://chalchitra-backend.onrender.com/logos/:path*"
    },
    {
      "source": "/misc/:path*",
      "destination": "https://chalchitra-backend.onrender.com/misc/:path*"
    },
    {
      "source": "/favicons/:path*",
      "destination": "https://chalchitra-backend.onrender.com/favicons/:path*"
    },
    {
      "source": "/health",
      "destination": "https://chalchitra-backend.onrender.com/health"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
